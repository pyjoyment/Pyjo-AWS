{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      // The cases of the AWS Signing Test Suite, which the tests read as they are
      "!**/t/aws-signing-test-suite/v4",
      // The cases of the provider of aws login of botocore, which the tests read as they are
      "!**/t/login-provider-test-cases/login-provider-test-cases.json",
      // Rewritten by trunk upgrade
      "!**/.trunk"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "useEditorconfig": true
  },
  "markdown": {
    "formatter": {
      // The HTML of a page, as the logo of README.md, stays as it is written
      "formatEmbeds": false
    }
  },
  "yaml": {
    "formatter": {
      // The line length of the Python code, as an expression of GitHub Actions
      // reads better on one line
      "lineWidth": 120
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        // Markdown, where the rest of the rules of markdownlint are about
        // formatting, which the formatter does; not useTopLevelHeading, as
        // CLAUDE.md starts with the import of AGENTS.md
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error"
      },
      "preset": "recommended"
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
